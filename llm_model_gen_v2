@contextmanager
def temporary_log_file(logger, path, *, level=None, mode="a", exclusive=True, propagate=False):
    old_handlers = logger.handlers[:]
    old_level = logger.level
    old_propagate = logger.propagate

    fh = logging.FileHandler(path, mode=mode, encoding="utf-8")
    fh.setFormatter(logging.Formatter(
        "%(asctime)s [%(processName)s %(threadName)s] %(levelname)s %(name)s: %(message)s"
    ))
    if level is not None:
        logger.setLevel(level)
        fh.setLevel(level)

    try:
        if exclusive:
            for h in old_handlers:
                logger.removeHandler(h)
        logger.addHandler(fh)
        logger.propagate = propagate
        yield
    finally:
        logger.removeHandler(fh)
        fh.flush(); fh.close()
        # restore
        for h in old_handlers:
            if h not in logger.handlers:
                logger.addHandler(h)
        logger.setLevel(old_level)
        logger.propagate = old_propagate

class llmrun():
  def __init__(self):
    self.args = {}
    self.split_paths = []
    self.jobs = []
    self.error_list = []
    self.failed_log_list = []
    self.triage_path = ""

  def set_split_directory_paths(self):
    if self.dv.is_qwen3_vl(self.dv.config['model_repo']):
      paths = list(dict.fromkeys(path for _, _, _, path in self.dv.qwen3_split_paths()))
      if self.dv.config.get('vision_out'):
        paths.append(Path(self.dv.config['vision_out']) / 'default/default_split')
      for path in paths:
        if not (path / 'dvrun_config.yaml').is_file():
          raise FileNotFoundError(f'Missing split configuration in {path}')
      self.split_paths = [str(path) for path in paths]
      return
    for yaml_path in glob.glob(os.path.join(self.dv.config["out"],self.dv.llm_output_dir) +"/prmpt*/*/"+"dvrun_config.yaml"):
      self.split_paths.append(os.path.dirname(yaml_path))
    

    # uncomment below line if wanted to exclude  prmt/split_32 model
    # self.split_paths = self.split_paths[:-1]

    for yaml_path in glob.glob(os.path.join(self.dv.config["out"],self.dv.llm_output_dir) +"/tkn*/*/"+"dvrun_config.yaml"):
      self.split_paths.append(os.path.dirname(yaml_path))

    for yaml_path in glob.glob(os.path.join(self.dv.config["out"],self.dv.llm_output_dir) +"/lmhead*/*/"+"dvrun_config.yaml"):
