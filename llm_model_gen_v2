  def is_qwen3_vl(self, model_dir):
    config = Path(model_dir) / 'config.json'
    if not config.is_file():
      return False
    return json.loads(config.read_text()).get('model_type') == 'qwen3_vl'

  def qwen3_tool_volume(self):
    tool = '/dv2/utils/qwen3_vl_4b'
    source = Path(__file__).resolve().parent / 'ara_docker' / tool.lstrip('/')
    return f'{source}:{tool}:ro'

  def export_qwen3_language(self):
    cfg = self.config
    if cfg['quantization'] != 'float' or cfg.get('num_mcs_shards', 1) != 1:
      raise ValueError("The Qwen3-VL-4B v2 exporter requires the original float checkpoint and one Ara endpoint")
    model = str(Path(cfg['model_dir']).resolve())
    out = str(Path(cfg['out']).resolve())
    joint = cfg.get('multimodal_standard_compilation', False)
    if not isinstance(joint, bool):
      raise ValueError('multimodal_standard_compilation must be a YAML boolean')
    args = ['bash', 'export.sh', model, out, cfg.get('rope', {}).get('vl_rope_type', DEFAULT_ROPE_TYPE),
            str(cfg.get('specd_size', 1))]
    if joint:
      args.append('--joint')
    self.exec_process([shlex.join(args)], [f'{model}:{model}:ro', f'{out}:{out}', self.qwen3_tool_volume()],
                      '/dv2/utils/qwen3_vl_4b/language', log_file_name='language_export.log')
    self.change_out_dir_perm(out)

