  def get_rel_tag(self):
      tag = self.docker_img.split(":")[-1]
      return tag.rsplit("-", 1)[0]

  def exec_process(self, command, volumes, working_dir, env=None, log_file_name = "dvrun.log"):
    cmds = ""
    vols = ""
    for c in command:
      cmds = cmds + " " + c
    for v in volumes:
      vols += " -v " + v
    try:
      client = docker.from_env()
      environment = ["PYTHONUNBUFFERED=1"]
      if env:
        environment.append(env)
      logger.info("command to execute: " + cmds)
      with open(os.path.join(self.config["out"],log_file_name), self.write_or_append) as log_file:
        log_file.write("command to execute: " + cmds + '\n')
      logger.info("running : " + cmds + " log: " + os.path.join(self.config["out"],log_file_name) + '\n')
      # client.images.pull(self.docker_img)
      container = client.containers.run(image=self.docker_img, volumes=volumes, working_dir=working_dir, command=cmds, detach=True, environment=environment)
      for line in container.logs(stdout=True, stderr=True, stream=True):
        decoded_line = line.decode('utf-8').strip()
        with open(os.path.join(self.config["out"],log_file_name), "a") as log_file:
          log_file.write(decoded_line + '\n')
      exit_status = container.wait()['StatusCode']
      try:
        if exit_status != 0:
          container.reload()
          if container.attrs['State'].get('OOMKilled'):
            raise MemoryError(f"Docker ran out of memory running {command[0]}. See {log_file_name}")
          raise RuntimeError(f"Container exited with code {exit_status}. See {log_file_name}")
      finally:
        container.remove()
      return exit_status
    except docker.errors.ContainerError as exc:
      logger.error("failed to run container")
      raise exc
    except docker.errors.ImageNotFound as exc:
      logger.error("docker image not found")
      raise exc
    except docker.errors.APIError as exc:
      logger.error("error when running docker API")
      raise exc

