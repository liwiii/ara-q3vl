  def validate_config(self, mode):
    config = self.config
    if (mode == 1 or mode == 5):
      required_fields = ['model_dir', 'quantization', 'out']
      for field in required_fields:
          if field not in config or not config[field]:
              raise ValueError(f"Missing required field: {field}")

      # Quantization type checks
      quantization_types = ['gguf', 'gptq', 'float']
      if config['quantization'] not in quantization_types:
          raise ValueError(f"Unsupported quantization type: {config['quantization']}")

      # gguf_file requirement
      if config['quantization'] == 'gguf':
          if 'gguf_file' not in config or not config['gguf_file']:
              raise ValueError("gguf_file must be set when quantization is 'gguf'")
          if not os.path.isfile(config['gguf_file']):
              raise ValueError(f"gguf_file does not exist: {config['gguf_file']}")
      else:
          if 'gguf_file' in config and config['gguf_file']:
              raise ValueError("gguf_file should not be set unless quantization is 'gguf'")

      # Directory checks
      if not os.path.isdir(config['model_dir']):
          raise ValueError(f"model_dir does not exist: {config['model_dir']}")
      if not os.path.isdir(config['out']):
          raise ValueError(f"output dir does not exist: {config['out']}")
    else:
      required_str_dirs = [
        'model_repo', 'onnx_model_repo', 'original_model_repo', 'out'
      ]
      required_list_ints = [
        'prmpt_prc_sizes', 'tkn_gen_sizes'
      ]

      # 1. Check required string directory paths
      for key in required_str_dirs:
          if key not in config or not isinstance(config[key], str) or not config[key]:
              raise ValueError(f"Missing or invalid value for '{key}' (must be non-empty string)")
          if not os.path.isdir(config[key]):
              raise ValueError(f"Directory path does not exist: {config[key]}")

      # 2. Check integer fields
      if 'prmpt_context_size' not in config or not isinstance(config['prmpt_context_size'], int):
          raise ValueError("Missing or non-integer 'prmpt_context_size'")
          # 3. Check boolean field
      if 'use_8bit_prompt' not in config or not isinstance(config['use_8bit_prompt'], bool):
        raise ValueError("Missing or non-bool 'use_8bit_prompt'")

    # 4. Check list-of-int fields
      for key in required_list_ints:
        if key not in config or not isinstance(config[key], list) or not all(isinstance(i, int) for i in config[key]):
            raise ValueError(f"'{key}' must be a list of integers")

    # 5. Check attention_scale_layers and qxk_out_scale_32_layers (must be lists)
      for key in ['attention_scale_layers', 'qxk_out_scale_32_layers']:
        if key not in config or not isinstance(config[key], list):
            raise ValueError(f"Missing or non-list '{key}'")

    # 6. Check weight_config structure
      if 'weight_config' not in config or not isinstance(config['weight_config'], dict):
        raise ValueError("weight_config must be present and a dictionary")
      for proj_type, quant_dict in config['weight_config'].items():
        if not isinstance(quant_dict, dict):
            raise ValueError(f"weight_config['{proj_type}'] must be a dictionary")
        for quant, layers in quant_dict.items():
            if not isinstance(layers, list) or not all(isinstance(l, int) for l in layers):
                raise ValueError(f"weight_config['{proj_type}']['{quant}'] must be a list of integers")

    print("Config valid.")


    # All checks passed

