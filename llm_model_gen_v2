      sys.exit(1)

  def safe_function_call(self, function_list):
    try:
      function, args = function_list
      return function(args)
    except Exception as e:
      return "ERROR: " + str(e)

  def print_progress(self, done, success, error, total, start_time):
      # Metrics
      pending = total - done
      percent = (done / total) * 100 if total else 0
      elapsed = time.time() - start_time
      speed = done / elapsed if elapsed > 0 else 0
      eta = (total - done) / speed if speed > 0 else 0

      def fmt_time(seconds):
          if seconds < 60:
              return f"{seconds:4.1f}s"
          elif seconds < 3600:
              m, s = divmod(int(seconds), 60)
              return f"{m:02d}m{s:02d}s"
          else:
              h, rem = divmod(int(seconds), 3600)
              m, s = divmod(rem, 60)
              return f"{h:02d}h{m:02d}m{s:02d}s"

      elapsed_str = fmt_time(elapsed)
      eta_str = fmt_time(eta)

      # Terminal width for dynamic bar
      term_width = shutil.get_terminal_size((100, 20)).columns
      bar_len = max(10, min(40, term_width // 3))  # scale to terminal

      # Bar drawing
      filled_len = int(bar_len * done // total) if total else 0
      bar = "█" * filled_len + "-" * (bar_len - filled_len)

      # Output line
      msg = (
          f"\r[{bar}] {done}/{total} "
          f"(success: {success} | error: {error} | pending: {pending}) "
          f"{percent:5.1f}% | {speed:.2f} job/s | Elapsed {elapsed_str} | ETA {eta_str}"
      )

      sys.stdout.write(msg)
      sys.stdout.flush()

  def func_pool_map(self, jobs, max_workers=1):
      try:
          results, errors, successes = [], 0, 0
          total = len(jobs)
          start = time.time()
          self.print_progress(0, 0, 0, total, start)
          sys.stdout.write("\n")
          with multiprocessing.Pool(processes=max_workers) as pool:
              pending_jobs = [pool.apply_async(self.safe_function_call, args=(job,)) for job in jobs]
              for i, r in enumerate(pending_jobs, start=1):
                  res = r.get()
                  results.append(res)
                  if str(res).startswith("ERROR:"):
                      errors += 1
                      logger.error(res)
                      self.failed_log_list.append(res.split("log_file:")[-1].strip())
                      self.error_list.append(str(res))
                  else:
                      successes += 1
                  self.print_progress(i, successes, errors, total, start)
              pool.close()
              pool.join()
          sys.stdout.write("\n")
          return results
      except Exception as e:
          raise Exception("func_pool_map failed with error: " + str(e))

  def timediff(self,end_time, begin_time):
    """return wall clock time difference
    Args:
      end_time (datetime) : end time
      begin_time (datetime) : begin time
    Returns: a dict
      wc_tsec   : wall clock time in seconds
      wc_hrs    : wall clock hours
      wc_mins   : wall clock minutes
      wc_secs   : wall clock seconds
    """
    r = {}
    et = end_time - begin_time
    tsec = et.total_seconds()
    r['wc_tsec'] = et.total_seconds()
    r['wc_hrs'] = int(tsec // 3600)
    r['wc_mins'] = int((tsec % 3600) // 60)
    r['wc_secs'] = int((tsec % 3600) % 60)
    return r


  def get_log_tail(self, lfn, marker=True):
    r = {}
    strl = []
    if marker == True:
      strl.append(">>========")
    strl.append("=====log tail=====")
    if os.path.isfile(lfn):
      strl.append("log file: " + lfn)
      r['rv'] = subprocess.run("tail -18 " + lfn, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, shell=True, text=True)
      if (r['rv'].returncode != 0):
        raise Exception("FAILED : + ", "log file: " + lfn , " exitcode : ", r[''].returncode, " message: ", r['rv'].stdout)
      strl.append(r['rv'].stdout)
    else:
      strl.append("no log file: " + lfn)
    if marker == True:
      strl.append("=========================<<")
    strl.append("\n")
    return strl

  def get_unique_splits(self):
    self.unique_splits = []
    weight_keys_path = os.path.join(os.path.join(self.dv.config["out"],self.dv.llm_output_dir,"assets","weight_config.json"))
    with open(weight_keys_path, "r", encoding="utf-8") as f:
      weight_keys = json.load(f)
    for key in weight_keys.keys():
      if len(weight_keys[key]) > 0:
        unique_idx = weight_keys[key][0]
        for path in self.split_paths:
          if path.endswith(f"/split_{unique_idx}"):
            self.unique_splits.append(path)



  def exec_splits_in_parallel(self):
    try:
      if self.args.num_of_cores == 0:
        self.args.num_of_cores = multiprocessing.cpu_count()
      self.get_unique_splits()
      for i in self.split_paths:
        dvobj = dvrun(os.path.join(i, "dvrun_config.yaml"), self.args)
        model_name =  "/".join(i.split("/")[-2:]).replace("/","_")
        if i in self.unique_splits:
          self.jobs.append([dvobj.run, model_name])
        else:
          self.jobs.append([dvobj.run, model_name])
      logger.info("total splits running {}".format(len(self.jobs)))
      self.func_pool_map(self.jobs, max_workers = self.args.num_of_cores)
      logger.info("total: {} passed: {} failed: {}".format(len(self.jobs), len(self.jobs)-len(self.error_list), len(self.error_list)))
      logger.error("failed list : \n{}".format(self.error_list))
      if len(self.error_list) > 0:
        self.triage_path = os.path.join(self.dv.config["out"], "split_failures.log")
        with open(self.triage_path, "w") as file:
          for lfn in self.failed_log_list:
            file.write("\n".join(self.get_log_tail(lfn)))
            file.write("\n")
        logger.info("triage: {}".format(self.triage_path))
        raise Exception("split runs failed")
    except Exception as e:
      raise Exception("exec_splits_in_parallel failed with error: "+str(e))



  def run(self):
    try:
      self.dv = dvrun(self.args.config, self.args) #This is a bug.
      # dvrun() object must be created with generated dvrun_config.yaml not with llm_model_(gen_)config.yaml
      logger.info(f"Running in mode: {self.args.mode}")
      mode = int(self.args.mode)
      if mode == 1:
        self.dv.validate_config(mode)
        self.dv.exec_convert_to_onnx()
        logger.info("Convert to onnx succesful")
      elif mode == 2 or mode == 3 or mode == 4:
        #Create output and run llm_converter
        self.dv.validate_config(mode) 
        if mode == 2 or mode == 3:
          self.dv.exec_pre_split()
          if mode == 3:
            logger.info("Generated Splits and exiting")
            return
        self.set_split_directory_paths()
        # to run prompt and token directories parallely
        if mode == 2 or mode == 4:
          logger.info("running splits parallely")
          splits_log = os.path.join(self.dv.config["out"],"splits_run.log")
          logger.info("parallel splits run log: %s",splits_log)
          with temporary_log_file(logger, splits_log, level=logging.INFO, exclusive=True):
              self.exec_splits_in_parallel()
          logger.info("finished running splits")

        # create all_dvms.txt file
        self.dv.write_dvm_paths_to_file()

        # to stitch all split's model.dvm's into one model.dvm
        self.dv.exec_llm_model_gen()
        
        self.dv.change_out_dir_perm(os.path.abspath(self.dv.config['out']))
        logger.info("final LLM model.dvm path {}".format(os.path.join(self.dv.config['out'], self.dv.llm_output_dir, 'model.dvm')))

        # No dvm splits/stitching yet, so pick dvm from default_split.
        if (self.dv.config.get("vision_out", None)):
          logger.info("final vision model.dvm path {}".format(os.path.join(self.dv.config['vision_out'], 'default/default_split/assets/model.dvm')))
          
        logger.info("llmrun executed successful")

      elif mode == 5:
          self.dv.validate_config(mode)
          self.dv.prepare_qwen3_vision()
          model_name_tagging_run = self.dv.config['model_dir'].replace("/", "_")
          # self.dv is not usable to invoke dvrun because it was created with --config
          # received from commandline for THIS tool. So we create a fresh dvrun object.
          dvobj = dvrun(os.path.join(self.dv.config['out'], 'dvrun_config.yaml'), self.args)
          dvobj.run(model_name_tagging_run)

      elif mode == 6:
        self.set_split_directory_paths()
        self.dv.write_dvm_paths_to_file()
        dvm_file = os.path.join(self.dv.run_dir, os.path.abspath(os.path.join(self.dv.config['out'], self.dv.llm_output_dir, 'model.dvm')))
        dvm_info_file = os.path.join(self.dv.run_dir, os.path.abspath(os.path.join(self.dv.config['out'], self.dv.llm_output_dir, 'model.dvm.txt')))
        try:
          logger.info(f"trying to delete dvm_file: {dvm_file} and {dvm_info_file}")
          os.remove(dvm_file)
          logger.info(f"Succesfully deleted dvm_file: {dvm_file}")
          os.remove(dvm_info_file)
          logger.info(f"Succesfully deleted dvm_info_file: {dvm_info_file}")
        except FileNotFoundError as e:
          logger.info(f"The file does not exist and could not be deleted. Proceeding: {e}")
        except PermissionError as e:
          logger.error(f"Don't have permission to delete the files. Please delete. {e}")
          raise RuntimeError(srt(e))
        self.dv.exec_llm_model_gen()
        self.dv.change_out_dir_perm(os.path.abspath(self.dv.config['out']))
        logger.info("final LLM model.dvm path after rewrite {}".format(os.path.join(self.dv.config['out'], self.dv.llm_output_dir, 'model.dvm')))


      else:
        logger.error("Invalid mode ")
    except Exception:
      logger.exception("llmrun execution failed")
      raise SystemExit(1)

  def parse_args(self):
    parser = argparse.ArgumentParser()
    parser.add_argument('--mode', required=True, help='1 : convert to onnx, 2 : generate and compile model, 3: generate model, 4: compile model, 5: generate and compile vision model, 6: stitch llm model.dvm')
    parser.add_argument('--config', required=True, help='path to configuration file')
    parser.add_argument('--num_of_cores', required=False, default = 0, type=int, help='num_cores to use for running splits parallely, default: uses all cores available on host')
    parser.add_argument('--skip-model-conversion', default=False, action='store_true', help='skip model conversion from pytorch if already done previously')
    self.args = parser.parse_args()
    logger.info("parsed command line arguments")

if __name__ == '__main__':
  runner = llmrun()
  runner.parse_args()
  runner.run()
