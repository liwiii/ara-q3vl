  def qwen3_split_paths(self):
    cfg = self.config
    with (Path(cfg['model_repo']) / 'config.json').open() as f:
      depth = json.load(f)['text_config']['num_hidden_layers']
    llm = Path(cfg['out']) / self.llm_output_dir
    for stage, sizes, prefix in ((0, cfg['prmpt_prc_sizes'], 'prmpt_prc'),
                                 (1, cfg['tkn_gen_sizes'], 'tkn_gen')):
      for size in sorted(sizes):
        # The SDK always names the prompt directory prmpt_prc_128. The DVM
        # manifest carries the actual prompt batch size from the configuration.
        directory = llm / (f'{prefix}_{size}' if stage else 'prmpt_prc_128')
        for idx in range(depth):
          yield stage, size, idx, directory / f'split_{idx}'
        if stage == 1:
          yield stage, size, depth, llm / 'lmhead' / f'split_{depth}'

  def write_dvm_paths_to_file(self):
    if self.is_qwen3_vl(self.config['model_repo']):
      lines = []
      for stage, size, idx, path in self.qwen3_split_paths():
        assets = path.resolve() / 'assets'
        if not (assets / 'model.dvm').is_file():
          raise FileNotFoundError(f'Missing compiled split: {assets}/model.dvm')
        lines.append(f'{stage},{size},{idx},{assets}/\n')
      dest = Path(self.config['out']) / self.llm_output_dir / 'all_dvms.txt'
      dest.write_text(''.join(lines))
      return lines
    if (self.config.get("num_mcs_shards", 1) > 1):
      return self.write_sharded_dvm_paths_to_file()
    # This only scans dvms in self.llm_output_dir. Skips other modalities.
    res = []
    res_dict = {}
    for i in os.listdir(os.path.join(self.config["out"],self.llm_output_dir)):
      if not os.path.isdir(os.path.join(self.config["out"],self.llm_output_dir)+'/'+i) or 'lmhead' in i:
        continue
      k = '0'
      if not i.startswith('prmpt_prc'):
        k = '1'
      tkn_sz = i.split('_')[-1]
      for j in os.listdir(os.path.join(self.config["out"],self.llm_output_dir)+'/'+i):
        if not os.path.isdir(os.path.join(self.config["out"],self.llm_output_dir)+'/'+i+'/'+j):
          continue
        if not j.startswith('split'):
          continue
        idx = j.split('_')[-1]
        if int(k) not in res_dict.keys():
          res_dict[int(k)] = {}
        if int(tkn_sz) not in res_dict[int(k)].keys():
          res_dict[int(k)][int(tkn_sz)] = []
        res_dict[int(k)][int(tkn_sz)].append(','.join([k,tkn_sz,idx,os.path.abspath(self.config["out"]+'/'+self.llm_output_dir+'/'+i+'/'+j+'/assets/\n')]))
      
        # res.append(k+','+tkn_sz+','+idx+','+self.config["out"]+'/'+self.llm_output_dir+'/'+i+'/'+j+'/assets/\n')
    for i in os.listdir(os.path.join(self.config["out"],self.llm_output_dir)):
      if 'lmhead' not in i:
        continue
      for j in os.listdir(os.path.join(self.config["out"],self.llm_output_dir)+'/'+i):
        idx = j.split('_')[-1]
        for key in res_dict[1].keys():
          res_dict[1][key].append(','.join(['1',str(key),str(idx),os.path.abspath(self.config["out"]+'/'+self.llm_output_dir+'/'+i+'/'+j+'/assets/\n')]))
          res_dict[1][key].sort(key= lambda x : int(x.split(',')[2]))
    for key in sorted(res_dict.keys()):
      for level in sorted(res_dict[key].keys()):
        res.extend(res_dict[key][level])
    with open(os.path.join(self.config["out"],self.llm_output_dir,'all_dvms.txt'), 'w') as f:
      f.writelines(res)
    logger.info("splits assets paths written to : {}".format(os.path.join(self.config["out"],self.llm_output_dir)+'/all_dvms.txt'))
    return res

  def write_sharded_dvm_paths_to_file(self, run_prefix='', unpack_path=None, unpack_run_prefix=None):
    """
    Write DVM paths to file for sharded models.
    
    This function extracts and sorts DVM paths for sharded models, similar to 
    the logic in get_all_sharded_dvm_paths.py but integrated into the LLM model 
    generation workflow.
    
    Args:
        run_prefix (str): Run prefix for path generation
        unpack_path (str): Path for unpacking
        unpack_run_prefix (str): Run prefix for unpacking paths
        
    Returns:
        list: List of DVM paths written to file
    """
    path = os.path.join(self.config["out"], self.llm_output_dir)
    res = []
    paths = [p for p in os.listdir(path) if 'tkn_gen' in p or 'prmpt_prc' in p or 'lmhead' in p]
    token_gen_sizes = list(set([i.split('_')[-1] for i in paths if i.startswith('tkn_gen')]))
    
    # Sort the paths for consistent processing
    paths = sorted(paths)
    
    def path_sort_key(path_str):
        # Format is now {shard_idx},{k},{tkn_szx},{idx}
        # We sort based on these four numbers in order: shard_idx, k, tkn_szx, idx
        parts = path_str.split(",")[:4]
        return [int(parts[0]), int(parts[1]), int(parts[2]), int(parts[3])]
    
    for i in paths:
      if not os.path.isdir(os.path.join(path, i)):
        continue
      k = '0'
      if not i.startswith('prmpt_prc'):
        k = '1'
      if not i.startswith('prmpt_prc') and not i.startswith('tkn_gen') and not i.startswith('lmhead'):
        continue
      tkn_sz = i.split('_')[-1]
      for j in os.listdir(os.path.join(path, i)):
        if not os.path.isdir(os.path.join(path, i, j)):
          continue
        # Handle both regular splits and sharded splits
        if not j.startswith('split'):
          continue
        # Extract index and shard_idx from directory names like split_0_shard_1
        parts = j.split('_')
        if len(parts) >= 3 and parts[-2] == 'shard':
          # This is a sharded directory: split_{layer_idx}_shard_{shard_idx}
          idx = parts[-3]  # Layer index
          shard_idx = parts[-1]  # Shard index
        else:
          # This is a non-sharded directory: split_{idx}
          idx = j.split('_')[-1]
          shard_idx = '0'  # Default shard index for non-sharded cases
        if i.startswith('lmhead'):
          for tk in token_gen_sizes:
            res.append(shard_idx+','+'1'+','+tk+','+idx+','+os.path.join(path, i, j, 'assets/')+'\n')
        else:
          res.append(shard_idx+','+k+','+tkn_sz+','+idx+','+os.path.join(path, i, j, 'assets/')+'\n')
    
    if unpack_path:
      unpack_paths = [p for p in os.listdir(unpack_path) if 'split' in p]
      for idx in range(len(unpack_paths)):
        res.append('0,2,128,'+str(idx)+','+os.path.join(unpack_path,'split_'+str(idx)+'assets/')+'\n')
    
    # Sort paths according to the key function
    res = sorted(res, key=path_sort_key)
    
    # Write to file
    run_prefix_str = run_prefix + '.' if run_prefix else ''
    file_path = os.path.join(path, 'all_dvms.' + run_prefix_str + 'txt')
    with open(file_path, 'w') as f:
      f.writelines(res)
    logger.info("sharded splits assets paths written to : {}".format(file_path))
    return res



